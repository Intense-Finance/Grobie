# Portable launcher: uses $GROBIE_PYTHON, then ./venv/bin/python, then python3 on PATH.
set -euo pipefail
D="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
if [ -n "${GROBIE_PYTHON:-}" ]; then
  PY="$GROBIE_PYTHON"
elif [ -x "$D/venv/bin/python" ]; then
  PY="$D/venv/bin/python"
else
  PY="$(command -v python3)"
fi
exec "$PY" "$D/grobie_voice.py" "$@"
